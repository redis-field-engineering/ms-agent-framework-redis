# Copy to .env.local, chmod 600, and fill settings for the sample you run.
# This is shell syntax. Never commit the completed file.
REDIS_IRIS_ENDPOINT=""
# Iris for current self-managed routes; Legacy preserves the original managed contract.
REDIS_IRIS_API_MODE="Legacy"
REDIS_IRIS_STORE_ID=""
REDIS_IRIS_API_KEY=""
OPENAI_API_KEY=""
REDIS_IRIS_CONTEXT_RETRIEVER_MCP_ENDPOINT=""
REDIS_IRIS_CONTEXT_RETRIEVER_AGENT_KEY=""
REDIS_IRIS_CONTEXT_RETRIEVER_CREDENTIAL_VERSION="environment-v1"
# Opt-in chat tools prepare memory proposals; saving requires an explicit user action in /memories.
# Requires REDIS_IRIS_API_MODE=Iris.
REDIS_IRIS_MEMORY_TOOLS_ENABLED=false
