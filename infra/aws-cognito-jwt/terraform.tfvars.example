aws_region                 = "us-east-1"
name_prefix                = "redis-iris-maf-yourname"
context_retriever_audience = "https://redis-iris-context-retriever"

callback_urls = ["http://localhost:5080/signin-oidc"]
logout_urls   = ["http://localhost:5080/"]

# Preview only: enable after Redis confirms surface IdP configuration is available.
configure_context_retriever_idp = false
context_retriever_surface_id    = ""

# Demo only. These temporary passwords are stored in Terraform state.
demo_users = {
  avery = {
    email       = "avery@example.com"
    tenant_id   = "redis-travel-demo"
    traveler_id = "traveler-001"
  }
  blake = {
    email       = "blake@example.com"
    tenant_id   = "redis-travel-demo"
    traveler_id = "traveler-002"
  }
}
